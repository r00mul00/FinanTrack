@attribute [AllowAnonymous]

<label class="ft-field">
    <span class="ft-field-label">@Label</span>
    <MudTextField T="string"
                  Value="Value"
                  ValueChanged="ValueChanged"
                  Variant="Variant.Outlined"
                  InputType="@(_visible ? InputType.Text : InputType.Password)"
                  Adornment="Adornment.End"
                  AdornmentIcon="@(_visible ? Icons.Material.Rounded.VisibilityOff : Icons.Material.Rounded.Visibility)"
                  AdornmentAriaLabel="Mostrar ou ocultar a senha"
                  OnAdornmentClick="() => _visible = !_visible"
                  Required="true"
                  RequiredError="Informe a senha."
                  Immediate="true"
                  Validation="Validation"
                  autocomplete="@Autocomplete" />
</label>

@code {
    private bool _visible;

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Senha";
    [Parameter] public string Autocomplete { get; set; } = "current-password";
    [Parameter] public Func<string, string?>? Validation { get; set; }
}
