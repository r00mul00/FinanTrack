@attribute [AllowAnonymous]
@inject TransactionApi Transactions
@inject CardApi CardsApi
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
        }
        <MudForm @ref="_form">
            <MudGrid Spacing="3">
                <MudItem xs="12">
                    <LabeledTextField @bind-Value="_description" Label="Descrição" RequiredError="Informe a descrição." MaxLength="200" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <div class="ft-field ft-tx-amount">
                        <span class="ft-field-label">Valor (R$)</span>
                        <MudNumericField T="decimal?" @bind-Value="_amount" Variant="Variant.Outlined"
                                         Min="0.01m" Max="Money.MaxValue" Culture="Money.Culture" Format="N2"
                                         HideSpinButtons="true" Immediate="true"
                                         Required="true" RequiredError="Informe o valor." />
                    </div>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <div class="ft-field ft-tx-type">
                        <span class="ft-field-label">Tipo</span>
                        <MudSelect T="TransactionType" Value="_type" ValueChanged="OnTypeChanged" Variant="Variant.Outlined" aria-label="Tipo">
                            @foreach (var type in Enum.GetValues<TransactionType>())
                            {
                                <MudSelectItem Value="type">@type.Label()</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <div class="ft-field ft-tx-category">
                        <span class="ft-field-label">Categoria</span>
                        <MudSelect T="Guid?" @bind-Value="_categoryId" Variant="Variant.Outlined" aria-label="Categoria"
                                   Required="true" RequiredError="Selecione a categoria." ToStringFunc="CategoryName">
                            @foreach (var category in CategoryOptions)
                            {
                                <MudSelectItem T="Guid?" Value="category.Id">@category.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                </MudItem>

                @if (CanUseCard)
                {
                    <MudItem xs="12" sm="6">
                        <div class="ft-field ft-tx-card">
                            <span class="ft-field-label">Cartão (opcional)</span>
                            <MudSelect T="Guid?" @bind-Value="_cardId" Variant="Variant.Outlined" aria-label="Cartão"
                                       Placeholder="Não usar cartão" Clearable="true" ToStringFunc="CardName">
                                @foreach (var card in Cards)
                                {
                                    <MudSelectItem T="Guid?" Value="card.Id">@card.Nickname (final @card.LastFour)</MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                    </MudItem>
                }

                @if (UsesCard)
                {
                    <MudItem xs="12" sm="6">
                        <div class="ft-field ft-tx-installments">
                            <span class="ft-field-label">Parcelas</span>
                            <MudNumericField T="int" @bind-Value="_installments" Variant="Variant.Outlined" Min="1" Max="48"
                                             HideSpinButtons="true" Immediate="true" />
                        </div>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" sm="6">
                        <div class="ft-field ft-tx-account">
                            <span class="ft-field-label">Conta</span>
                            <MudSelect T="Guid?" @bind-Value="_accountId" Variant="Variant.Outlined" aria-label="Conta"
                                       Required="true" RequiredError="Selecione a conta." ToStringFunc="AccountName">
                                @foreach (var account in AccountOptions)
                                {
                                    <MudSelectItem T="Guid?" Value="account.Id">@account.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                    </MudItem>
                }

                <MudItem xs="12" sm="6">
                    <div class="ft-field ft-tx-date">
                        <span class="ft-field-label">Data da movimentação</span>
                        <MudDatePicker @bind-Date="_date" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" Culture="BrazilianCulture.Instance"
                                       AutoClose="true" Required="true" RequiredError="Informe a data." />
                    </div>
                </MudItem>

                @if (!UsesCard)
                {
                    <MudItem xs="12" sm="6">
                        <div class="ft-field ft-tx-due">
                            <span class="ft-field-label">Vencimento (opcional)</span>
                            <MudDatePicker @bind-Date="_dueDate" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" Culture="BrazilianCulture.Instance"
                                           AutoClose="true" Clearable="true" />
                        </div>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <div class="ft-field ft-tx-status">
                            <span class="ft-field-label">Status</span>
                            <MudSelect T="TransactionStatus" @bind-Value="_status" Variant="Variant.Outlined" aria-label="Status">
                                @foreach (var status in Enum.GetValues<TransactionStatus>())
                                {
                                    <MudSelectItem Value="status">@status.Label()</MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                    </MudItem>

                    <MudItem xs="12">
                        <div class="ft-field ft-tx-notes">
                            <span class="ft-field-label">Observações (opcional)</span>
                            <MudTextField T="string" @bind-Value="_notes" Variant="Variant.Outlined" Lines="2" MaxLength="1000" Immediate="true" />
                        </div>
                    </MudItem>
                }
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Disabled="_busy" OnClick="CancelAsync">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="SaveAsync">
            @if (_busy)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Inherit" Class="mr-2" />
            }
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private sealed record Snapshot(string Description, decimal? Amount, TransactionType Type, Guid? CategoryId, Guid? AccountId,
        DateTime? Date, DateTime? DueDate, TransactionStatus Status, string Notes, Guid? CardId, int Installments);

    private Guid? _cardId;
    private int _installments = 1;

    private MudForm _form = default!;
    private string? _description;
    private decimal? _amount;
    private TransactionType _type = TransactionType.EXPENSE;
    private Guid? _categoryId;
    private Guid? _accountId;
    private DateTime? _date = DateTime.Today;
    private DateTime? _dueDate;
    private TransactionStatus _status = TransactionStatus.COMPLETED;
    private string? _notes;
    private string? _error;
    private bool _busy;
    private Snapshot _initial = default!;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Nula ao criar; preenchida ao editar.</summary>
    [Parameter] public TransactionResponse? Transaction { get; set; }
    [Parameter] public IReadOnlyList<CategoryResponse> Categories { get; set; } = [];
    [Parameter] public IReadOnlyList<AccountResponse> Accounts { get; set; } = [];
    [Parameter] public IReadOnlyList<CardResponse> Cards { get; set; } = [];

    /// <summary>Cartão só existe no cadastro de despesas; parcelas são geridas em Cartões.</summary>
    private bool CanUseCard => Transaction is null && _type == TransactionType.EXPENSE && Cards.Count > 0;

    private bool UsesCard => CanUseCard && _cardId is not null;

    private string CardName(Guid? id) => Cards.FirstOrDefault(c => c.Id == id)?.Nickname ?? "";

    /// <summary>Itens arquivados só aparecem se a movimentação já os utiliza.</summary>
    private IEnumerable<CategoryResponse> CategoryOptions => Categories.Where(c =>
        c.Type == _type.ToCategoryType() && (!c.Archived || c.Id == Transaction?.CategoryId));

    private IEnumerable<AccountResponse> AccountOptions => Accounts.Where(a =>
        !a.Archived || a.Id == Transaction?.AccountId);

    private string CategoryName(Guid? id) => Categories.FirstOrDefault(c => c.Id == id)?.Name ?? "";

    private string AccountName(Guid? id) => Accounts.FirstOrDefault(a => a.Id == id)?.Name ?? "";

    protected override void OnInitialized()
    {
        if (Transaction is not null)
        {
            _description = Transaction.Description;
            _amount = Transaction.Amount;
            _type = Transaction.Type;
            _categoryId = Transaction.CategoryId;
            _accountId = Transaction.AccountId;
            _date = Transaction.TransactionDate.ToDateTime(TimeOnly.MinValue);
            _dueDate = Transaction.DueDate?.ToDateTime(TimeOnly.MinValue);
            _status = Transaction.Status;
            _notes = Transaction.Notes;
        }
        else if (AccountOptions.Count() == 1)
        {
            _accountId = AccountOptions.First().Id;
        }
        _initial = Current();
    }

    private Snapshot Current() =>
        new(_description ?? "", _amount, _type, _categoryId, _accountId, _date, _dueDate, _status, _notes ?? "", _cardId, _installments);

    /// <summary>A categoria selecionada deixa de valer quando o tipo muda.</summary>
    private void OnTypeChanged(TransactionType type)
    {
        _type = type;
        _categoryId = null;
        _cardId = null;
    }

    private async Task CancelAsync()
    {
        if (Current() != _initial)
        {
            var discard = await Dialogs.ShowMessageBoxAsync(
                "Descartar alterações?", "As alterações feitas serão perdidas.",
                yesText: "Descartar", cancelText: "Continuar editando");
            if (discard != true)
            {
                return;
            }
        }
        MudDialog.Cancel();
    }

    private async Task SaveAsync()
    {
        if (_busy)
        {
            return;
        }
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _busy = true;
        _error = null;

        if (UsesCard)
        {
            var purchase = await CardsApi.CreatePurchaseAsync(_cardId!.Value, new PurchaseRequest(
                _description!.Trim(), _amount!.Value, _installments, _categoryId!.Value, DateOnly.FromDateTime(_date!.Value)));
            _busy = false;
            if (purchase.Success)
            {
                Snackbar.Add("Compra registrada no cartão.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                _error = purchase.Message;
            }
            return;
        }

        var request = new TransactionRequest(
            _description!.Trim(), _amount!.Value, _type, _status, _categoryId!.Value, _accountId!.Value,
            DateOnly.FromDateTime(_date!.Value),
            _dueDate is null ? null : DateOnly.FromDateTime(_dueDate.Value),
            string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim(),
            Transaction?.Version);
        var result = Transaction is null
            ? await Transactions.CreateAsync(request)
            : await Transactions.UpdateAsync(Transaction.Id, request);
        _busy = false;

        if (result.Success)
        {
            Snackbar.Add(Transaction is null ? "Movimentação cadastrada." : "Movimentação atualizada.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            _error = result.Message;
        }
    }
}
