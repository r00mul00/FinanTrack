@attribute [AllowAnonymous]
@using System.Globalization

<MudPaper Elevation="0" Class="ft-card pa-5">
    <div class="d-flex justify-space-between align-center mb-3">
        <MudText Typo="Typo.subtitle1">Últimas transações</MudText>
        <MudLink Href="/transacoes" Typo="Typo.body2">Ver todas</MudLink>
    </div>

    @if (Items is null)
    {
        @for (var i = 0; i < 3; i++)
        {
            <MudSkeleton Height="52px" />
        }
    }
    else if (Items.Count == 0)
    {
        <div class="ft-chart-empty small">Nenhuma movimentação neste período.</div>
    }
    else
    {
        @foreach (var item in Items)
        {
            <div class="ft-recent-row">
                <span class="ft-category-icon small" style="background-color: @(item.CategoryColor ?? NeutralColor)26; color: @(item.CategoryColor ?? NeutralColor);">
                    <MudIcon Icon="@(item.CategoryIcon is null ? Icons.Material.Rounded.CreditCard : CategoryAppearance.IconFor(item.CategoryIcon))" Size="Size.Small" />
                </span>
                <div class="ft-category-name">
                    <MudText Typo="Typo.body2" Class="ft-ellipsis">@item.Description</MudText>
                    <MudText Typo="Typo.caption" Class="ft-ellipsis" Style="color: var(--mud-palette-text-secondary);">
                        @(item.CategoryName ?? "Fatura de cartão") · @item.TransactionDate.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)@(item.Status == TransactionStatus.COMPLETED ? "" : $" · {item.Status.Label()}")
                    </MudText>
                </div>
                <span class="@(item.Type == TransactionType.INCOME ? "ft-amount-income" : "ft-amount-expense")">
                    @(item.Type == TransactionType.INCOME ? "+" : "-") @Money.Format(item.Amount)
                </span>
            </div>
        }
    }
</MudPaper>

@code {
    private const string NeutralColor = "#A6A8BC";

    [Parameter] public IReadOnlyList<TransactionResponse>? Items { get; set; }
}
