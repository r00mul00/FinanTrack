@inherits LayoutComponentBase
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Components.Sections
@using FinanTrack.Web.Components.Notifications
@inject AuthSession Session
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized Context="authState">
        <MudLayout>
            <MudAppBar Elevation="0" Color="Color.Transparent">
                <MudIconButton Icon="@Icons.Material.Rounded.Menu"
                               Color="Color.Inherit"
                               Edge="Edge.Start"
                               aria-label="Alternar menu"
                               OnClick="ToggleDrawer" />
                @if (!_drawerOpen)
                {
                    <div class="ml-2"><Brand /></div>
                }
                <MudSpacer />

                @* A pesquisa global é o item 6.23; fica desabilitada até lá. *@
                <div class="d-none d-sm-flex flex-grow-1 justify-end mr-2">
                    <MudTextField T="string"
                                  Class="ft-search"
                                  Placeholder="Pesquisar"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Rounded.Search"
                                  Disabled="true" />
                </div>
                <div class="d-none d-md-flex mr-2">
                    <SectionOutlet SectionName="@TopBarActions" />
                </div>
                <NotificationBell />

                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" AriaLabel="Menu do perfil">
                    <ActivatorContent Context="menu">
                        <button type="button" class="ft-avatar-button ml-2" aria-label="Abrir menu do perfil" @onclick="e => menu.ToggleAsync(e)">
                            <MudAvatar Color="Color.Primary" Size="Size.Small">@Initial</MudAvatar>
                        </button>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="px-4 py-2">
                            <MudText Typo="Typo.body2">@Session.CurrentUser?.Name</MudText>
                            <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">@Session.CurrentUser?.Email</MudText>
                        </div>
                        <MudDivider />
                        <MudMenuItem Href="/configuracoes" Icon="@Icons.Material.Rounded.Settings">Configurações</MudMenuItem>
                        <MudMenuItem OnClick="LogoutAsync" Icon="@Icons.Material.Rounded.Logout">Sair</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </MudAppBar>

            <MudDrawer @bind-Open="_drawerOpen"
                       Variant="DrawerVariant.Responsive"
                       Breakpoint="Breakpoint.Md"
                       ClipMode="DrawerClipMode.Never"
                       Elevation="0">
                <div class="ft-drawer">
                    <div class="px-2"><Brand /></div>
                    <div class="ft-drawer-nav">
                        <NavMenu />
                    </div>
                    <div class="ft-drawer-footer">
                        <div class="ft-drawer-user">
                            <MudText Typo="Typo.body2" Class="ft-ellipsis">@Session.CurrentUser?.Name</MudText>
                            <MudText Typo="Typo.caption" Class="ft-ellipsis" Style="color: var(--mud-palette-text-secondary);">@Session.CurrentUser?.Email</MudText>
                        </div>
                        <MudTooltip Text="Sair">
                            <MudIconButton Icon="@Icons.Material.Rounded.Logout" Size="Size.Small" aria-label="Sair" Disabled="_loggingOut" OnClick="LogoutAsync" />
                        </MudTooltip>
                    </div>
                </div>
            </MudDrawer>

            <MudMainContent>
                <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
                    @Body
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        <div class="ft-boot">Carregando o FinanTrack...</div>
        @Body
    </NotAuthorized>
    <Authorizing>
        <div class="ft-boot">Carregando o FinanTrack...</div>
    </Authorizing>
</AuthorizeView>

@code {
    /// <summary>Área da barra superior preenchida pelas páginas, como o seletor de período.</summary>
    public const string TopBarActions = "top-bar-actions";

    private bool _drawerOpen = true;
    private bool _loggingOut;

    private string Initial => string.IsNullOrEmpty(Session.CurrentUser?.Name)
        ? ""
        : Session.CurrentUser.Name[..1].ToUpperInvariant();

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    /// <summary>O recarregamento completo garante que nada da sessão fique em memória.</summary>
    private async Task LogoutAsync()
    {
        if (_loggingOut)
        {
            return;
        }
        _loggingOut = true;
        await Session.LogoutAsync();
        Navigation.NavigateTo("login", forceLoad: true);
    }
}
