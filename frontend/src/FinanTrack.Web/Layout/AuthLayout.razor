@inherits LayoutComponentBase
@attribute [AllowAnonymous]

<div class="ft-auth-page">
    <div class="ft-auth-column">
        <div class="d-flex flex-column align-center mb-6">
            <Brand />
            <MudText Typo="Typo.body2" Class="mt-2" Style="color: var(--mud-palette-text-secondary);">
                Controle suas finanças. Conquiste seus objetivos.
            </MudText>
        </div>
        <FinanTrack.Web.Demo.DemoNotice OnLoginPage="true" Class="mb-4" />
        <MudPaper Elevation="0" Class="ft-card pa-6">
            @Body
        </MudPaper>
    </div>
</div>
