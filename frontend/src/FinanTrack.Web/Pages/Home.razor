@page "/"
@using System.Globalization
@using FinanTrack.Web.Components.Dashboard
@using Microsoft.AspNetCore.Components.Sections
@inject DashboardApi Dashboard
@inject TransactionApi Transactions
@inject BudgetApi BudgetsApi
@inject GoalApi GoalsApi
@inject UserApi Users
@inject PeriodState Period
@implements IDisposable

<PageTitle>Dashboard | FinanTrack</PageTitle>

<SectionContent SectionName="@MainLayout.TopBarActions">
    <PeriodSelector />
</SectionContent>

<div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-1">
    <MudText Typo="Typo.h4" HtmlTag="h1">Dashboard</MudText>
    <div class="d-md-none"><PeriodSelector /></div>
</div>
<MudText Typo="Typo.body1" Class="mb-6" Style="color: var(--mud-palette-text-secondary);">
    @(_user is null ? "Controle suas finanças. Conquiste seus objetivos." : $"Olá, {_user.Name}. Controle suas finanças. Conquiste seus objetivos.")
</MudText>

@if (_loadFailed)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        Não foi possível carregar todos os dados.
        <MudLink Class="ml-1" Style="cursor: pointer;" OnClick="LoadAsync">Tentar novamente</MudLink>
    </MudAlert>
}

<MudGrid Spacing="3">
    <MudItem xs="12" sm="6" lg="3">
        <StatCard Title="Saldo total" Icon="@Icons.Material.Rounded.AccountBalance" Value="_summary?.TotalBalance"
                  ShowChange="false" Caption="Contas ativas, valores efetivados" />
    </MudItem>
    <MudItem xs="12" sm="6" lg="3">
        <StatCard Title="Receitas" Icon="@Icons.Material.Rounded.ArrowDownward" Value="_summary?.Income" Change="_summary?.IncomeChange" />
    </MudItem>
    <MudItem xs="12" sm="6" lg="3">
        <StatCard Title="Despesas" Icon="@Icons.Material.Rounded.ArrowUpward" Value="_summary?.Expenses" Change="_summary?.ExpensesChange" HigherIsBetter="false" />
    </MudItem>
    <MudItem xs="12" sm="6" lg="3">
        <StatCard Title="Resultado" Icon="@Icons.Material.Rounded.Balance" Value="_summary?.Result" Change="_summary?.ResultChange" />
    </MudItem>

    <MudItem xs="12" lg="8">
        <IncomeExpenseChart Data="_series" />
    </MudItem>
    <MudItem xs="12" lg="4">
        <CategoryDonut Data="_categories" />
    </MudItem>

    <MudItem xs="12" lg="8">
        <RecentTransactions Items="_recent" />
    </MudItem>
    <MudItem xs="12" lg="4">
        <UpcomingDues Items="_upcoming" />
    </MudItem>

    <MudItem xs="12" md="6">
        <GoalsOverview Goals="_goals" />
    </MudItem>
    <MudItem xs="12" md="6">
        <BudgetAlerts Budgets="_budgets" />
    </MudItem>
</MudGrid>

@code {
    private const int RecentCount = 5;

    private UserResponse? _user;
    private DashboardSummaryResponse? _summary;
    private IncomeVsExpenseResponse? _series;
    private List<CategoryExpenseResponse>? _categories;
    private List<TransactionResponse>? _recent;
    private List<UpcomingDueResponse>? _upcoming;
    private List<GoalResponse>? _goals;
    private List<BudgetResponse>? _budgets;
    private bool _loadFailed;
    private int _loadId;

    protected override async Task OnInitializedAsync()
    {
        Period.Changed += OnPeriodChanged;
        _user = await Users.GetCurrentAsync();
        await LoadAsync();
    }

    private void OnPeriodChanged() => InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        var loadId = ++_loadId;
        _loadFailed = false;
        _summary = null;
        _series = null;
        _categories = null;
        _recent = null;
        _upcoming = null;
        _goals = null;
        _budgets = null;
        StateHasChanged();

        var (from, to) = (Period.From, Period.To);
        var filter = new TransactionFilter(null, null, null, null, from, to);
        var summary = Dashboard.GetSummaryAsync(from, to);
        var series = Dashboard.GetIncomeVsExpenseAsync(from, to);
        var categories = Dashboard.GetExpensesByCategoryAsync(from, to);
        var recent = Transactions.ListAsync(filter, 0, RecentCount, null);
        // Vencimentos, metas e alertas refletem o momento atual, não o período selecionado.
        var upcoming = Dashboard.GetUpcomingAsync();
        var goals = GoalsApi.ListAsync();
        var budgets = BudgetsApi.GetMonthAsync(DateTime.Today.ToString("yyyy-MM", CultureInfo.InvariantCulture));
        await Task.WhenAll(summary, series, categories, recent, upcoming, goals, budgets);

        // Se o período mudou durante a consulta, só a resposta mais nova é exibida.
        if (loadId != _loadId)
        {
            return;
        }

        _summary = summary.Result;
        _series = series.Result;
        _categories = categories.Result;
        _recent = recent.Result?.Content;
        _upcoming = upcoming.Result;
        _goals = goals.Result;
        _budgets = budgets.Result?.Items;
        _loadFailed = _summary is null || _series is null || _categories is null || _recent is null
            || _upcoming is null || _goals is null || _budgets is null;
        StateHasChanged();
    }

    public void Dispose() => Period.Changed -= OnPeriodChanged;
}
