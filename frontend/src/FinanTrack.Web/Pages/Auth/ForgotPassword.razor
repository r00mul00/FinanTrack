@page "/recuperar-senha"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject AuthApi Auth

<PageTitle>Recuperar senha | FinanTrack</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-4">Recuperar senha</MudText>

@if (_done)
{
    <MudAlert Severity="Severity.Success" Class="mb-4">
        Se houver uma conta com este e-mail, enviamos um link válido por 30 minutos. Ele pode levar alguns segundos para chegar.
    </MudAlert>
}
else
{
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
    }
    <MudForm @ref="_form" Spacing="4" OnEnterPressed="SubmitAsync">
        <LabeledTextField @bind-Value="_email" Label="E-mail" InputType="InputType.Email"
                          RequiredError="Informe o e-mail." Validation="@(AuthRules.Email)" Autocomplete="email" />
        <SubmitButton Text="Enviar link" Busy="_busy" OnClick="SubmitAsync" />
    </MudForm>
}

<div class="mt-4">
    <MudLink Href="/login" Typo="Typo.body2">Voltar para o login</MudLink>
</div>

@code {
    private MudForm _form = default!;
    private string? _email;
    private string? _error;
    private bool _busy;
    private bool _done;

    private async Task SubmitAsync()
    {
        if (_busy)
        {
            return;
        }
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _busy = true;
        _error = null;
        var result = await Auth.ForgotPasswordAsync(_email!.Trim());
        _busy = false;

        if (result.Success)
        {
            _done = true;
        }
        else
        {
            _error = result.Message;
        }
    }
}
