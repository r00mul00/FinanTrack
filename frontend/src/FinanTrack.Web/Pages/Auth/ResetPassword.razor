@page "/redefinir-senha"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject AuthApi Auth
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Redefinir senha | FinanTrack</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-4">Redefinir senha</MudText>

@if (string.IsNullOrEmpty(Token))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">Link inválido. Solicite uma nova redefinição.</MudAlert>
    <MudLink Href="/recuperar-senha" Typo="Typo.body2">Solicitar novo link</MudLink>
}
else
{
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">
            @_error
            <MudLink Class="ml-1" Href="/recuperar-senha">Solicitar novo link</MudLink>
        </MudAlert>
    }
    <MudForm @ref="_form" Spacing="4" OnEnterPressed="SubmitAsync">
        <PasswordField @bind-Value="_password" Label="Nova senha" Autocomplete="new-password"
                       Validation="@(AuthRules.NewPassword)" />
        <PasswordField @bind-Value="_confirmation" Label="Confirmar nova senha" Autocomplete="new-password"
                       Validation="@ConfirmMatches" />
        <SubmitButton Text="Salvar nova senha" Busy="_busy" OnClick="SubmitAsync" />
    </MudForm>
}

@code {
    private MudForm _form = default!;
    private string? _password;
    private string? _confirmation;
    private string? _error;
    private bool _busy;

    [SupplyParameterFromQuery] public string? Token { get; set; }

    private string? ConfirmMatches(string value) => value == _password ? null : "As senhas não conferem.";

    private async Task SubmitAsync()
    {
        if (_busy)
        {
            return;
        }
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _busy = true;
        _error = null;
        var result = await Auth.ResetPasswordAsync(new ResetPasswordRequest(Token!, _password!));
        _busy = false;

        if (result.Success)
        {
            Snackbar.Add("Senha alterada. Entre com a nova senha.", Severity.Success);
            Navigation.NavigateTo("login", replace: true);
        }
        else
        {
            _error = result.Message;
        }
    }
}
