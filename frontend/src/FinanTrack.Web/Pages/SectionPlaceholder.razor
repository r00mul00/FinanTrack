@page "/orcamentos"
@page "/metas"
@page "/cartoes"
@page "/recorrencias"
@page "/relatorios"
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@_section.Title | FinanTrack</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-6">@_section.Title</MudText>

<MudPaper Elevation="0" Class="ft-card pa-8 d-flex flex-column align-center">
    <MudIcon Icon="@Icons.Material.Rounded.Construction" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
    <MudText Typo="Typo.h6">Módulo em desenvolvimento</MudText>
    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">Previsto para a @_section.Phase.</MudText>
</MudPaper>

@code {
    private static readonly Dictionary<string, (string Title, string Phase)> Sections = new()
    {
        ["orcamentos"] = ("Orçamentos", "Fase 6"),
        ["metas"] = ("Metas financeiras", "Fase 6"),
        ["cartoes"] = ("Cartões", "Fase 6"),
        ["recorrencias"] = ("Contas recorrentes", "Fase 6"),
        ["relatorios"] = ("Relatórios", "Fase 7")
    };

    private (string Title, string Phase) _section;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        UpdateSection();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateSection();
        StateHasChanged();
    }

    private void UpdateSection()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        Sections.TryGetValue(path, out _section);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
