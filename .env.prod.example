# Variáveis de PRODUÇÃO. Nunca versione o arquivo preenchido.
#
# Para gerar o .env.prod com senha do banco e segredo do JWT aleatórios:
#   sh infra/generate-secrets.sh
# Depois, preencha o restante. No provedor de hospedagem, cadastre os mesmos
# valores como variáveis/segredos do serviço, e não como arquivo.
#
# A API se recusa a subir no perfil prod se encontrar valores de exemplo
# (que começam com "defina"), segredos fracos ou endereços sem HTTPS.

# --- Banco ---
# No docker-compose.prod.yml a URL é montada a partir de DB_NAME. Num banco
# gerenciado, defina DB_URL=jdbc:postgresql://<host>:5432/<banco>?sslmode=require
DB_NAME=finantrack
DB_USERNAME=finantrack
# Mínimo de 12 caracteres.
DB_PASSWORD=defina-uma-senha-forte

# --- Autenticação ---
# Mínimo de 32 bytes, aleatório. Trocá-lo encerra todas as sessões abertas.
JWT_SECRET=defina-um-segredo-aleatorio-com-pelo-menos-32-bytes

# --- Endereços ---
# Endereço público do app, com HTTPS; usado nos links enviados por e-mail.
FRONTEND_URL=https://defina-o-dominio
# Só se o frontend estiver em outra origem (separe por vírgula). Na topologia
# padrão, Nginx e API ficam na mesma origem e isto fica vazio.
CORS_ALLOWED_ORIGINS=

# --- E-mail (SMTP do provedor de envio) ---
MAIL_HOST=defina-o-servidor-smtp
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=nao-responda@defina-o-dominio
